local function getOwnerFromAdornee(adornee)
    if not adornee then return nil end
    local part=adornee:IsA('BasePart') and adornee
        or adornee:FindFirstAncestorWhichIsA('BasePart')
    if not part then return nil end
    return part:FindFirstAncestorOfClass('Model') or part
end
-- Uma vez escolhido o Part do alvo, nao procura todos os descendentes
-- novamente a cada ciclo do Evento.
local eventRootCache=setmetatable({}, {__mode='k'})
local function getEventRoot(instance)
    if not instance then return nil end
    if instance:IsA('BasePart') then return instance end
    if not instance:IsA('Model') then return nil end
    local root=eventRootCache[instance]
    if root and root.Parent and root:IsDescendantOf(instance) then return root end
    root=instance:FindFirstChild('HumanoidRootPart') or instance.PrimaryPart
    if not root then
        for _,child in ipairs(instance:GetChildren()) do
            if child:IsA('BasePart') then
                root=child
                if normalize(child.Name):find('pumpkin',1,true) then break end
            end
        end
    end
    if not root then
        -- Busca recursiva apenas uma vez por modelo, nunca por clique.
        root=instance:FindFirstChildWhichIsA('BasePart',true)
    end
    if root then eventRootCache[instance]=root end
    return root
end
local pumpkinLabels=setmetatable({},{__mode='k'})
