local pumpkinCache={last=-1,target=nil,root=nil}
local function findEventTarget()
    local now=os.clock()
    if now-pumpkinCache.last<0.9 then
        if pumpkinCache.target and pumpkinCache.root and pumpkinCache.target.Parent
            and pumpkinCache.root.Parent and not blockedTargets[pumpkinCache.target]
            and not isBlocked(pumpkinCache.root.Position) then
            return pumpkinCache.target,pumpkinCache.root
        end
        return nil,nil
    end
    pumpkinCache.last=now
    local _,_,myRoot=charParts()
    if not myRoot then return nil,nil end
    local best,bestRoot,bestDist=nil,nil,math.huge
    local seen={}
    local function consider(candidate)
        if not candidate or seen[candidate] or blockedTargets[candidate] then return end
        seen[candidate]=true
        if candidate==player.Character or candidate.Name=='Map' then return end
        if candidate:IsA('Model') and Players:GetPlayerFromCharacter(candidate) then return end
        -- Filtrar ANTES de percorrer as partes do modelo.
        local named=hasKeyword(candidate.Name,eventKeywords)
            or candidate:GetAttribute('IsEvent')==true
            or candidate:GetAttribute('EventEnemy')==true
        if not named and not pumpkinLabels[candidate] and not eventCandidates[candidate]
            and theme.eventModes[S.eventMode]~='PIRATE RAID' then return end
        local root=getEventRoot(candidate)
        if not root or not root:IsDescendantOf(workspace) then return end
        if isBlocked(root.Position) then return end
        local hum=candidate:IsA('Model') and candidate:FindFirstChildOfClass('Humanoid')
        if hum and hum.Health<=0 then return end
        local allowed=pumpkinLabels[candidate] and theme.eventModes[S.eventMode]=='PUMPKIN'
        if not allowed and not eventModelAllowed(candidate,root) then return end
        local distance=(myRoot.Position-root.Position).Magnitude
        if distance<bestDist then best,bestRoot,bestDist=candidate,root,distance end
    end
    local checkedCandidates=0
    for candidate in pairs(eventCandidates) do
        if candidate.Parent then consider(candidate)
        else eventCandidates[candidate]=nil; pumpkinLabels[candidate]=nil end
        checkedCandidates+=1
        if checkedCandidates>=180 then break end
    end
    -- Pastas de NPCs/eventos e a raiz: so uma passagem curta a cada busca.
    for _,folder in ipairs({workspace:FindFirstChild('Enemies'),workspace:FindFirstChild('Events')}) do
        if folder then
            local looked=0
            for _,item in ipairs(folder:GetChildren()) do
                if item:IsA('Model') or item:IsA('BasePart') then consider(item) end
                looked+=1
                if looked>=320 then break end
            end
        end
    end
    if not best then
        local looked=0
        for _,item in ipairs(workspace:GetChildren()) do
            looked+=1
            if looked>=320 then break end
            if (item:IsA('Model') or item:IsA('BasePart'))
                and (hasKeyword(item.Name,eventKeywords)
                    or item:GetAttribute('IsEvent')==true) then
                consider(item)
            end
        end
    end
    pumpkinCache.target,pumpkinCache.root=best,bestRoot
    return best,bestRoot
end

-- O nome exibido na foto e "Jack o' Lantern [Lv. 21]".
-- Ignora apostrofos, acentos de aspas e a marca de nivel.
local function isJackName(name)
    local compact=normalize(name):gsub('[^%a%d]','')
    return compact:find('jackolantern',1,true)~=nil
end

-- ===== SNOWMAN: PRIORIDADE ABSOLUTA NO EVENTO =====
-- A etiqueta da imagem e 'Pumpkin Snowman'. Prioriza o NPC com Humanoid.
-- Busca uma vez a cada ~0,75s, usa cache e NAO varre o mapa inteiro.
-- Cache da busca vive neste bloco, sem consumir locais do script principal.
do
local lastSnowmanScan=-1
local snowmanCached,snowmanCachedRoot=nil,nil
snowman.find=function()
    if not S.eventRunning then return nil,nil end
    local now=os.clock()
    if snowmanCached and snowmanCached.Parent and not blockedTargets[snowmanCached] then
        local hum=snowmanCached:IsA('Model')
            and snowmanCached:FindFirstChildOfClass('Humanoid')
        if (not hum or hum.Health>0) and snowmanCachedRoot and snowmanCachedRoot.Parent
            and snowmanCachedRoot:IsDescendantOf(workspace) then
            return snowmanCached,snowmanCachedRoot
        end
    end
    if now-lastSnowmanScan<(currentFPS()<25 and 1.8 or 1.15) then return nil,nil end
    lastSnowmanScan=now
    local _,_,myRoot=charParts()
    if not myRoot then return nil,nil end
    local best,bestRoot,bestDist=nil,nil,math.huge
    local seen={}
    local function consider(model)
        if not model or seen[model] or not model.Parent or blockedTargets[model]
            or (not model:IsA('Model') and not model:IsA('BasePart')) then return end
        seen[model]=true
        if model==player.Character then return end
        if model:IsA('Model') and Players:GetPlayerFromCharacter(model) then return end
        if not snowman.isName(model.Name) and not snowman.labels[model] then return end
        -- Snowman pode ser um objeto coletavel (sem Humanoid) ou um mob.
        local hum=model:IsA('Model') and model:FindFirstChildOfClass('Humanoid')
        if hum and hum.Health<=0 then return end
        local root=getEventRoot(model)
        if not root or not root:IsDescendantOf(workspace) then return end
        local distance=(myRoot.Position-root.Position).Magnitude
        if distance<bestDist then best,bestRoot,bestDist=model,root,distance end
    end
    local checked=0
    for model in pairs(snowman.labels) do
        consider(model)
        checked=checked+1
        if checked>=100 then break end
    end
    for model in pairs(eventCandidates) do
        if snowman.isName(model.Name) then consider(model) end
        checked=checked+1
        if checked>=350 then break end
    end
    for _,folderName in ipairs({'Enemies','NPCs','Events','Halloween'}) do
        local folder=workspace:FindFirstChild(folderName)
        if folder then
            local count=0
            for _,model in ipairs(folder:GetChildren()) do
                consider(model)
                count=count+1
                if count>=350 then break end
            end
        end
    end
    -- Suporte a NPCs criados diretamente em Workspace.
    local count=0
    for _,model in ipairs(workspace:GetChildren()) do
        if snowman.isName(model.Name) then consider(model) end
        count=count+1
        if count>=300 then break end
    end
    snowmanCached,snowmanCachedRoot=best,bestRoot
    return best,bestRoot
end
end -- cache do Snowman

-- Localiza o Jack verdadeiro, isto e, um Model com Humanoid vivo.
-- O detector trabalha nas pastas de inimigos carregados do cliente.
local jackLastScan=-1
local jackLastAnchor=nil
local jackCachedModel,jackCachedRoot=nil,nil
local function findJackNpc(nearPosition, maxDistance)
    local now=os.clock()
    if now-jackLastScan<1.0 and (
        (nearPosition==nil and jackLastAnchor==nil) or
        (nearPosition and jackLastAnchor and (nearPosition-jackLastAnchor).Magnitude<12)
    ) then
        if jackCachedModel and jackCachedModel.Parent then
            local h=jackCachedModel:FindFirstChildOfClass('Humanoid')
            if h and h.Health>0 then return jackCachedModel,jackCachedRoot end
        else
            return nil,nil
        end
    end
    jackLastScan=now
    jackLastAnchor=nearPosition
    local _,_,myRoot=charParts()
    if not myRoot then return nil,nil end
    local best,bestRoot,bestDist=nil,nil,math.huge
    local pools={}
    local enemiesFolder=workspace:FindFirstChild('Enemies')
    local npcFolder=workspace:FindFirstChild('NPCs')
    if enemiesFolder then table.insert(pools,enemiesFolder) end
    if npcFolder then table.insert(pools,npcFolder) end
    -- Fallback pequeno para NPCs fora das pastas habituais.
    if #pools==0 then table.insert(pools,workspace) end
    local seen={}
    for _,pool in ipairs(pools) do
        if pool then
            for _,model in ipairs(pool:GetChildren()) do
                if model:IsA('Model') and not seen[model] then
                    seen[model]=true
                    if isJackName(model.Name) and not blockedTargets[model]
                        and not Players:GetPlayerFromCharacter(model) then
                        local h=model:FindFirstChildOfClass('Humanoid')
                        local r=getEventRoot(model)
                        if h and h.Health>0 and r and r:IsDescendantOf(workspace) then
                            local fromAnchor=nearPosition and (r.Position-nearPosition).Magnitude or 0
                            local playerDist=(myRoot.Position-r.Position).Magnitude
                            if (not nearPosition or fromAnchor<=(maxDistance or 180))
                                and (nearPosition or playerDist<=(maxDistance or 300))
                                and playerDist<bestDist then
                                best,bestRoot,bestDist=model,r,playerDist
                            end
                        end
                    end
                end
            end
        end
    end
    jackCachedModel,jackCachedRoot=best,bestRoot
    return best,bestRoot
end

local function eventTargetGone(target,root)
    if not S.eventRunning or not target or not root then return true end
    if not target:IsDescendantOf(workspace) or not root:IsDescendantOf(workspace) then return true end
    if target:IsA('Model') then
        local hum=target:FindFirstChildOfClass('Humanoid')
        if hum and hum.Health<=0 then return true end
    end
    return false
end
stopEvent=function(msg)
