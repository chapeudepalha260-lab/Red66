                            or tostring(tool:GetAttribute('WeaponType') or ''):lower()==class:lower()
                        if isType then
                            local ok,req=remoteOnce('UpgradeItem','Check',tool)
                            if ok and type(req)=='table' then
                                local count=type(req.Required)=='table' and #req.Required or 0
                                showMessage('UPGRADE '..class:upper(),tool.Name..' | Requisitos: '..count..' (ver no Blacksmith)',true)
                            else
                                showMessage('UPGRADE '..class:upper(),tool.Name..' | va ao Blacksmith para detalhes.',false)
                            end
