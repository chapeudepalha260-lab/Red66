local function questTask()
    local data = guide and guide.Data
    local quest = data and data.QuestData
    local tasks = quest and quest.Task
    if type(tasks) == 'table' then
        for name, required in pairs(tasks) do
            if type(name) == 'string' then
                return name, required
            end
        end
    end
