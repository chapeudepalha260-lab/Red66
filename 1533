local function decodeBase64(source)
    local out, buffer, bits = {}, 0, 0
    for i = 1, #source do
        local ch = source:byte(i)
        local num
        if ch >= 65 and ch <= 90 then num = ch - 65
        elseif ch >= 97 and ch <= 122 then num = ch - 71
        elseif ch >= 48 and ch <= 57 then num = ch + 4
        elseif ch == 43 then num = 62
        elseif ch == 47 then num = 63 end
        if num then
            buffer = bit32.lshift(buffer, 6) + num
            bits += 6
            if bits >= 8 then
                bits -= 8
                out[#out + 1] = string.char(bit32.extract(buffer, bits, 8))
                buffer = bit32.band(buffer, bit32.lshift(1, bits) - 1)
            end
        end
    end
    return table.concat(out)
end

local function embeddedImage(filename, encoded)
    if type(getcustomasset) ~= "function" or type(writefile) ~= "function" then return "" end
    local ok, asset = pcall(function()
        if type(isfile) ~= "function" or not isfile(filename) then
            writefile(filename, decodeBase64(encoded))
        end
        return getcustomasset(filename)
    end)
    return ok and asset or ""
end

