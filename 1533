-- Mantem o jogador no alcance durante o ataque: noclip sem sustentacao
-- fazia o personagem cair atraves do chao e errar os cliques.
S.attackHeight=8
local function holdNear(targetPosition)
    local _,humanoid,root=charParts()
    if not root or not targetPosition then return false end
    local away=root.Position-targetPosition
    local flat=Vector3.new(away.X,0,away.Z)
    local direction=flat.Magnitude>0.05 and flat.Unit or Vector3.new(0,0,1)
    local destination=targetPosition+Vector3.new(0,S.attackHeight,0)+direction*1.2
    if holdForce and holdForce.Parent~=root then
        holdForce:Destroy()
        holdForce=nil
    end
    if not holdForce then
        holdForce=Instance.new('BodyPosition')
        holdForce.Name='BLACK_FARM_ATTACK_HOLD'
        holdForce.MaxForce=Vector3.new(2000000,2000000,2000000)
        holdForce.P=7000
        holdForce.D=2000
        holdForce.Parent=root
    end
    holdForce.Position=destination
    local lookAt=targetPosition+Vector3.new(0,1.5,0)
    if (lookAt-root.Position).Magnitude>0.1 then
        -- Evita reenviar orientacao a cada golpe se ja estiver olhando para o alvo.
        local direction=(lookAt-root.Position).Unit
        if root.CFrame.LookVector:Dot(direction)<0.965 then
            root.CFrame=CFrame.lookAt(root.Position,lookAt)
        end
    end
    return (root.Position-destination).Magnitude<=3
end

-- ===== NOCLIP AUTOMATICO =====
-- Enquanto AUTO FARM, AUTO EVENTO ou AUTO PEGAR FRUTA estiver ligado,
-- as partes do personagem nao colidem com paredes/objetos durante o voo.
-- Ao desligar todas essas funcoes, restaura a colisao original das partes.
-- Acompanha respawn e pecas novas (acessorios/equipamentos).
local originalCollision = {}
local noclipCharacter = nil
local collisionConnection = nil
local function recordCollidable(part)
    if part and part:IsA('BasePart') and originalCollision[part]==nil then
        originalCollision[part]=part.CanCollide
    end
end
local function restoreNoclip()
    if collisionConnection then collisionConnection:Disconnect(); collisionConnection=nil end
    for part,original in pairs(originalCollision) do
        if part and part.Parent then
            pcall(function() part.CanCollide=original end)
        end
    end
    table.clear(originalCollision)
    noclipCharacter=nil
end
local function noclipWanted()
    return gui.Parent~=nil and (S.manualNoclip or S.manualTravel or S.running
        or S.eventRunning or S.collectFruit or (S.autoChest and chestFlightActive))
end
local function updateAutoNoclip()
    if not noclipWanted() then
        if noclipCharacter or next(originalCollision) then restoreNoclip() end
        return
    end
    local character=player.Character
    if noclipCharacter~=character then
        restoreNoclip()
        noclipCharacter=character
        if character then
            -- Apenas uma varredura por respawn; depois acompanha as pecas novas.
            for _,part in ipairs(character:GetDescendants()) do recordCollidable(part) end
            collisionConnection=character.DescendantAdded:Connect(recordCollidable)
        end
    end
    if not character then return end
    for part in pairs(originalCollision) do
        if part.Parent and part.CanCollide then part.CanCollide=false end
    end
end

local lastNoclipAt=0
local noclipConnection = RunService.Heartbeat:Connect(function()
    if os.clock()-lastNoclipAt>=0.2 then
        lastNoclipAt=os.clock()
        updateAutoNoclip()
    end
end)

