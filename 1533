do
local Lighting=game:GetService('Lighting')
local oldShadows=nil
local effectsBackup=setmetatable({},{__mode='k'})
applyLiteMode=function(enabled)
    if enabled then
        if oldShadows==nil then oldShadows=Lighting.GlobalShadows end
        Lighting.GlobalShadows=false
        for _,child in ipairs(Lighting:GetChildren()) do
            if child:IsA('PostEffect') then
                if effectsBackup[child]==nil then effectsBackup[child]=child.Enabled end
                child.Enabled=false
            end
        end
    else
        if oldShadows~=nil then
            Lighting.GlobalShadows=oldShadows
            oldShadows=nil
        end
        for effect,wasEnabled in pairs(effectsBackup) do
            if effect.Parent then effect.Enabled=wasEnabled end
        end
        table.clear(effectsBackup)
    end
end
end -- reservas do modo leve

