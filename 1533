-- ===== CLICKER 0.50S ADAPTATIVO (SEM SPAWN POR CLIQUE) =====
-- Um ataque e feito por vez. Nunca cria task.spawn por clique.
local CLICK_PROFILES={
    {name='PADRAO',delay=0.50},
    {name='LEVE',delay=0.75},
}
local smoothFrame=1/60
local fpsConnection=RunService.Heartbeat:Connect(function(dt)
    smoothFrame=smoothFrame*0.94+math.clamp(dt,0.001,0.20)*0.06
end)
local function currentFPS()
    return math.floor(1/math.max(0.001,smoothFrame)+0.5)
end
local function clickDelay(event)
    if event and not S.autoClick then return 0.75 end
    local profile=CLICK_PROFILES[event and S.eventClickProfile or S.farmClickProfile]
    local delay=profile.delay
    -- Se o jogo comecar a engasgar, o clicker reduz a carga sozinho.
    if smoothFrame>=0.085 then return math.max(delay,0.65) end -- queda severa de FPS
    if smoothFrame>=0.060 then return math.max(delay,0.45) end
    if smoothFrame>=0.044 then return math.max(delay,0.30) end
    if smoothFrame>=0.033 then return math.max(delay,0.23) end
    if smoothFrame>=0.027 then return math.max(delay,0.18) end
    return delay
end
