local onPageShown -- secoes grandes serao montadas apenas ao abrir a aba
local function showPage(name)
    if sense.close then sense.close() end
    for k,page in pairs(theme.pages) do page.Visible=k==name end
    local index=table.find(theme.pageNames,name)
    if index then
        theme.currentTabIndex=index
        local maxScroll=math.max(0,#theme.pageNames*105-theme.tabsScroller.AbsoluteSize.X)
        local desired=(index-1)*105-math.max(0,(theme.tabsScroller.AbsoluteSize.X-101)/2)
        theme.tabsScroller.CanvasPosition=Vector2.new(math.clamp(desired,0,maxScroll),0)
    end
    for k,b in pairs(theme.tabButtons) do
        -- Troca visual direta: evita criar 17 Tweens toda vez que muda de aba.
        b.BackgroundColor3=k==name and Color3.fromRGB(76,34,43) or Color3.fromRGB(35,35,40)
        b.TextColor3=k==name and white or Color3.fromRGB(167,159,171)
        local bar=b:FindFirstChild('ActiveMark')
        if bar then bar.Visible=(k==name) end
    end
    if onPageShown then task.defer(onPageShown,name) end
end
for name,tab in pairs(theme.tabButtons) do
