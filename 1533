local highlights=setmetatable({},{__mode='k'})
local espColor={player=Color3.fromRGB(60,175,255),npc=Color3.fromRGB(240,80,80),
    boss=Color3.fromRGB(250,160,50),fruit=Color3.fromRGB(120,255,100),
    chest=Color3.fromRGB(250,218,50)}
local function showESP(instance,kind,valid)
    if not instance or not instance.Parent then return end
    valid[instance]=true
    if highlights[instance] then return end
    local highlight=Instance.new('Highlight')
    highlight.Name='BLACK_FARM_ESP_MARKER'
    highlight.Adornee=instance
    highlight.FillColor=espColor[kind]
    highlight.OutlineColor=espColor[kind]
    highlight.FillTransparency=0.78
    highlight.OutlineTransparency=0
    highlight.DepthMode=Enum.HighlightDepthMode.Occluded
    highlight.Parent=gui
    highlights[instance]=highlight
end
task.spawn(function()
    while gui.Parent do
        task.wait(1.4)
        local valid={}
        local count=0
        local function canAdd() count=count+1; return count<=45 end
        if extraStates.espPlayers then
            for _,p in ipairs(Players:GetPlayers()) do
                if p~=player and p.Character and canAdd() then showESP(p.Character,'player',valid) end
            end
        end
        if extraStates.espNPCs or extraStates.espBosses then
            local folder=workspace:FindFirstChild('Enemies')
            if folder then
                for _,mob in ipairs(folder:GetChildren()) do
                    if count>=45 then break end
                    if mob:IsA('Model') then
                        local boss=mob.Name:lower():find('boss',1,true)~=nil
                        if ((boss and extraStates.espBosses) or (not boss and extraStates.espNPCs))
                            and mob:FindFirstChildOfClass('Humanoid') and canAdd() then
                            showESP(mob,boss and 'boss' or 'npc',valid)
                        end
                    end
                end
            end
        end
        if extraStates.espFruits then
            for _,item in ipairs(workspace:GetChildren()) do
                if count>=45 then break end
                if isRealFruitPickup(item) and canAdd() then showESP(item,'fruit',valid) end
            end
        end
        if extraStates.espChests then
            for _,chest in ipairs(CS:GetTagged('_ChestTagged')) do
                if count>=45 then break end
                if chest:IsA('BasePart') and canAdd() then showESP(chest,'chest',valid) end
            end
        end
        for inst,marker in pairs(highlights) do
            if not valid[inst] or not inst.Parent or not marker.Parent then
                marker:Destroy(); highlights[inst]=nil
            end
        end
    end
end)
gui.Destroying:Connect(function()
    for _,marker in pairs(highlights) do pcall(function() marker:Destroy() end) end
end)

