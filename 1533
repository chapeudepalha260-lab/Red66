-- ===============================================================
-- V22: tres secoes solicitadas do script de referencia.
-- Cada opcao e explicitamente rotulada se NAO tem automacao funcional.
-- APENAS uma rotina limitada verifica as acoes remotas agendadas.
-- Nenhuma varredura integral de workspace, hook de executor ou Sea Event.
-- ===============================================================
local function initReferenceSections()
    local slate=Color3.fromRGB(35,35,40)
    local accent=Color3.fromRGB(226,61,108)
    local active=Color3.fromRGB(30,128,83)
    local scheduled={}
    local customStates={}
    local now=os.clock
    local optionsInitialized=0

    -- Trabalho fracionado: a construcao do menu nao congela a partida.
    local function stagger()
        optionsInitialized+=1
        if optionsInitialized%4==0 then task.wait(0.025) end
    end
    local function section(where,name,desc)
        local line=menuNote(where,'━━━━  '..name:upper()..'  ━━━━')
        line.Font=Enum.Font.GothamBold
        line.TextSize=13
        line.TextColor3=Color3.fromRGB(255,149,180)
        if desc then menuNote(where,desc) end
        stagger()
    end
    local function note(where,title,desc)
        -- Nao mostra alternancia ON falsa em recursos que dependem de
        -- questlines inteiras e funcoes externas nao portadas.
        menuAction(where,'ⓘ  '..title..'  ·  INFO',function()
            showMessage('AINDA NAO AUTOMATIZADO',desc or
                'A funcao existe no menu original, mas depende de rotinas que nao estao neste script.',false)
        end)
        stagger()
    end
    local function action(where,title,fn)
        local b=menuAction(where,title,function()
            task.spawn(function()
                local ok,err=pcall(fn)
                if not ok then showMessage('FALHA',tostring(err):sub(1,105),false) end
            end)
        end)
        stagger()
        return b
    end
    local function toggle(where,title,key,onChange)
        extraStates[key]=false
        local b
        b=menuAction(where,title..': OFF',function()
            local enabled=not extraStates[key]
            extraStates[key]=enabled
            b.Text=title..': '..(enabled and 'ON' or 'OFF')
            b.BackgroundColor3=enabled and active or slate
            if onChange then onChange(enabled) end
        end)
        stagger()
        return b
    end
    local function remoteOnce(name,...)
        local remote=commRemote()
        if not remote or not remote:IsA('RemoteFunction') then
            return false,'CommF_ nao esta disponivel'
        end
        local args={...}
        local ok,value=pcall(function() return remote:InvokeServer(name,table.unpack(args)) end)
        return ok,value
    end
    local function request(name,...)
        local ok,res=remoteOnce(name,...)
        if ok then
            showMessage('RESPOSTA DO SERVIDOR',name..' : '..tostring(res):sub(1,80),true)
        else
            showMessage('COMANDO FALHOU',name..' : '..tostring(res):sub(1,80),false)
        end
        return ok,res
    end
    local function autoRemote(where,title,key,period,name,...)
        local args={...}
        toggle(where,title,key,function(enabled)
            if enabled then showMessage('AUTOMACAO LIGADA',title..' | tentativa a cada '..period..' s',true) end
        end)
        scheduled[#scheduled+1]={key=key,title=title,period=period,last=0,
            job=function() return remoteOnce(name,table.unpack(args)) end}
    end
    local function toolNamed(fragment)
        local backpack=player:FindFirstChild('Backpack')
        local ch=player.Character
        for _,folder in ipairs({backpack,ch}) do
            if folder then
                for _,item in ipairs(folder:GetChildren()) do
                    if item:IsA('Tool') and item.Name:lower():find(fragment:lower(),1,true) then return item end
                end
            end
        end
        return nil
    end
    local function gotoTemple()
        local map=workspace:FindFirstChild('Map')
        local temple=map and map:FindFirstChild('Temple of Time',true)
        if not temple then
            showMessage('LOCAL NAO DISPONIVEL','Temple of Time nao foi carregado no seu cliente.',false)
            return
        end
        local prompt=temple:FindFirstChild('Prompt',true)
        local p=prompt and (prompt:IsA('BasePart') and prompt or prompt.Parent)
            or temple:FindFirstChildWhichIsA('BasePart',true)
        if p and p:IsA('BasePart') then runManualJourney(p.Position+Vector3.new(0,3,0)) end
    end
    local function statusToolUpgrade(class)
        local backpack=player:FindFirstChild('Backpack')
        local ch=player.Character
        for _,folder in ipairs({backpack,ch}) do
            if folder then
                for _,tool in ipairs(folder:GetChildren()) do
