local function displayTextMatches(model,wanted)
    if not model then return false end
    if normalize(model.Name):find(wanted,1,true) then return true end
    -- Um evento pode exibir Pumpkin num BillboardGui e usar outro nome interno.
    for _,d in ipairs(model:GetDescendants()) do
        if d:IsA('TextLabel') and normalize(d.Text):find(wanted,1,true) then
            return true
        end
    end
    return false
