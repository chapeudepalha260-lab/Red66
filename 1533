-- RADAR INTELIGENTE: estado compartilhado sem criar novos loops por botao.
-- O controlador de voo existente continua sendo a unica autoridade de movimento.
local sense={
    farmSmart=true, autoEquip=true, watchMastery=true, watchDamage=true,
    skipStuck=true, eventPriority=1,
    orders={
        {'SNOWMAN','JACK','PUMPKIN'},
        {'JACK','SNOWMAN','PUMPKIN'},
        {'PUMPKIN','SNOWMAN','JACK'},
    },
    focusType='BUSCANDO', focusName='--', focusSince=os.clock(),
    farmTarget='--', damageState='Aguardando NPC', masteryState='--',
    radarSnow=false,radarJack=false,radarPumpkin=false,
    updatePanel=nil, scanState='AGUARDANDO', vipHighlight=nil, vipTarget=nil,
}
function sense.rank(kind)
    local order=sense.orders[sense.eventPriority]
    for i,v in ipairs(order) do if v==kind then return i end end
    return 99
end
function sense.higher(a,b)
    return sense.rank(a)<sense.rank(b)
end
function sense.focus(kind,name)
    if sense.focusType~=kind or sense.focusName~=name then
        sense.focusType=kind
        sense.focusName=name or '--'
        sense.focusSince=os.clock()
    end
end

