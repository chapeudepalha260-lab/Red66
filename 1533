local lastQuestUIScan=-1
local cachedQuestVisible,cachedQuestText=false,''
local function questUIState()
    if os.clock()-lastQuestUIScan<0.4 then return cachedQuestVisible,cachedQuestText end
    lastQuestUIScan=os.clock()
    local pg = player:FindFirstChild('PlayerGui')
    if not pg then return false, '' end
    local parts = {}
    local function grab(root)
        if not root then return end
        for _, obj in ipairs(root:GetDescendants()) do
            if (obj:IsA('TextLabel') or obj:IsA('TextButton'))
                and obj.Text ~= '' then
                table.insert(parts, obj.Text)
            end
        end
    end
    local main = pg:FindFirstChild('Main') or pg:FindFirstChild('Main (minimal)')
    local questFrame = main and main:FindFirstChild('Quest')
    if questFrame and questFrame:IsA('GuiObject') and questFrame.Visible then
        grab(questFrame)
    end
    local tracked = pg:FindFirstChild('TrackedQuestFrame')
    if tracked then
        local visible = (tracked:IsA('ScreenGui') and tracked.Enabled)
            or (tracked:IsA('GuiObject') and tracked.Visible)
        if visible then grab(tracked) end
    end
    cachedQuestVisible=#parts>0
    cachedQuestText=table.concat(parts,' | ')
    return cachedQuestVisible,cachedQuestText
end

local EXCLUDED_QUESTS = {
    BartiloQuest=true, Trainees=true, MarineQuest=true, CitizenQuest=true,
}
local function bestLevelQuest(filterName)
    local data = guide and guide.Data
    local npcs = data and data.NPCList
    if type(npcs)~='table' or type(quests)~='table' then return nil end
    local level=getLevel()
    local chosen, highest=nil, -math.huge
    -- Mesmo mapeamento do menu enviado: NPCList -> Levels -> Quests -> Task.
    for _, npc in pairs(npcs) do
        if type(npc)=='table' and npc.InternalQuestName and npc.Position
            and type(npc.Levels)=='table' then
            local qName=npc.InternalQuestName
            if not EXCLUDED_QUESTS[qName] and (not filterName or filterName==qName) then
                local group=quests[qName]
                for qId, listedLevel in pairs(npc.Levels) do
                    local entry=type(group)=='table' and group[qId]
                    local requirement=entry and tonumber(entry.LevelReq or listedLevel)
                    if entry and type(entry.Task)=='table' and requirement
                        and requirement<=level and requirement>highest
                        and entry.Name~='Town Raid' then
                        for mob,count in pairs(entry.Task) do
                            if type(mob)=='string' and tonumber(count) and tonumber(count)>1 then
                                chosen={name=qName,id=qId,pos=npc.Position,mob=mob,
                                    required=count,level=requirement}
                                highest=requirement
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    return chosen
end

