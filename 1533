-- Mesma abordagem do source: Heartbeat + FloatForce/BodyVelocity + CFrame,
-- velocidade por distancia e zero de velocidade fisica. Sem teleporte instantaneo.
-- Todas as abas chamam flyTo: Quest, Farm, Evento, Frutas, Baus, Bosses e TP.
local flight={serial=0,owner=nil,ongoing=false,
    priority={event=5,farm=4,fruit=3,chest=2,manual=1}}
local function cancelFlight()
    flight.serial=flight.serial+1
    flight.ongoing=false
    flight.owner=nil
    clearHover()
end
local function flyTo(pointFn, closeEnough, owner, onStuck)
    owner=owner or 'farm'
    closeEnough=closeEnough or 5
    if not travelActive(owner) or not gui.Parent then return false end
    -- So um controlador pode mover o jogador por vez. Evento tem prioridade.
    if flight.ongoing and flight.owner and flight.owner~=owner
        and (flight.priority[owner] or 0)<=(flight.priority[flight.owner] or 0)
        and travelActive(flight.owner) then
        return false
    end
    if flight.ongoing and flight.owner==owner then
        return false -- nao inicia dois voos do mesmo modo simultaneamente
    end
    flight.serial=flight.serial+1
    local token=flight.serial
    flight.owner=owner
    flight.ongoing=true
    if owner=='chest' then chestFlightActive=true end
    -- No primeiro frame ja atravesse obstaculos, sem esperar ciclo de 0.2s.
    updateAutoNoclip()
    local lastPosition=nil
    local stationarySince=os.clock()
    local lastCommanded=nil
    local correctionCount=0
    local function finish(arrived)
        if token==flight.serial then
            flight.ongoing=false
            flight.owner=nil
            clearHover()
            if owner=='chest' then chestFlightActive=false end
        end
        return arrived
    end
    while gui.Parent and travelActive(owner) and token==flight.serial do
        local character,humanoid,root=charParts()
        if not root or not humanoid or humanoid.Health<=0 then return finish(false) end
        local goal=coord(pointFn())
        if not goal then return finish(false) end
        local offset=goal-root.Position
        local distance=offset.Magnitude
        if distance<=closeEnough then
            root.AssemblyLinearVelocity=Vector3.zero
            root.AssemblyAngularVelocity=Vector3.zero
            return finish(true)
        end
        if not hover or hover.Parent~=root then
            clearHover()
            hover=Instance.new('BodyVelocity')
            hover.Name='BLACK_FARM_FLOAT_FORCE'
            hover.MaxForce=Vector3.new(100000,100000,100000)
            hover.P=10000
            hover.Velocity=Vector3.zero
            hover.Parent=root
        end
        -- Detecta travamento sem fazer outra varredura no workspace.
        if not lastPosition or (root.Position-lastPosition).Magnitude>=3 then
            lastPosition=root.Position
            stationarySince=os.clock()
        elseif os.clock()-stationarySince>=(owner=='event' and 10 or 9) then
            if onStuck then pcall(onStuck,goal) end
            return finish(false)
        end
        -- O source original controla RootPart no Heartbeat e evita exceder o
        -- passo fisico a cada frame, para reduzir correcoes bruscas do servidor.
        local dt=math.clamp(task.wait(1/30),1/240,0.12)
        if token~=flight.serial or not travelActive(owner) then break end
        if root.Parent~=player.Character then return finish(false) end
        if lastCommanded and (root.Position-lastCommanded).Magnitude>35 then
            correctionCount=math.min(8,correctionCount+1)
        else
            correctionCount=math.max(0,correctionCount-1)
        end
        local nextGoal=coord(pointFn())
        if not nextGoal then return finish(false) end
        offset=nextGoal-root.Position
        distance=offset.Magnitude
        if distance<=closeEnough then return finish(true) end
        -- Mantem 250 studs/s; reduz momentaneamente caso haja rubberband.
        local rate=math.max(100,S.speed*(correctionCount>=3 and 0.65 or 1))
        local step=math.min(distance,rate*dt,18)
        local nextPos=root.Position+offset.Unit*step
        local horizontal=Vector3.new(offset.X,0,offset.Z)
        root.CFrame=horizontal.Magnitude>0.02
            and CFrame.lookAt(nextPos,nextPos+horizontal.Unit) or CFrame.new(nextPos)
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
        lastCommanded=nextPos
    end
    return finish(false)
end

local function normalize(name)
    return tostring(name or ''):lower()
        :gsub('%s*%[lv%.?[^%]]*%]','')
        :gsub('%s*%b[]','')
        :gsub('^%s+',''):gsub('%s+$','')
end
local function nameMatches(actual,wanted)
    return normalize(actual)==normalize(wanted)
end
local function getTarget(name)
    local container=workspace:FindFirstChild('Enemies')
    if not container then return nil end
    local _,_,root=charParts()
    if not root then return nil end
    local best,bestDist
    for _,mob in ipairs(container:GetChildren()) do
        if mob:IsA('Model') and nameMatches(mob.Name,name) then
            local h=mob:FindFirstChildOfClass('Humanoid')
            local r=mob:FindFirstChild('HumanoidRootPart')
            if h and r and h.Health>0 then
                local dist=(root.Position-r.Position).Magnitude
                if not bestDist or dist<bestDist then
                    best,bestDist=mob,dist
                end
            end
        end
    end
    return best
end
-- NPCs que nao recebem dano ficam em pausa curta, sem desligar o Farm.
local ignoredFarmTargets=setmetatable({},{__mode='k'})
local function getNearest(names)
    local _,_,root=charParts()
    local enemies=workspace:FindFirstChild('Enemies')
    if not root or not enemies then return nil end
    local wanted={}
    for _,name in ipairs(names) do wanted[normalize(name)]=true end
    local best,bestDist=nil,math.huge
    -- UMA passagem pelo container inteiro, e nao uma por nome de NPC.
    for _,mob in ipairs(enemies:GetChildren()) do
        if mob:IsA('Model') and wanted[normalize(mob.Name)]
            and (not ignoredFarmTargets[mob] or ignoredFarmTargets[mob]<=os.clock()) then
            local h=mob:FindFirstChildOfClass('Humanoid')
            local r=mob:FindFirstChild('HumanoidRootPart')
            if h and r and h.Health>0 then
                local dist=(root.Position-r.Position).Magnitude
                if dist<bestDist then best,bestDist=mob,dist end
            end
        end
    end
    return best
end

local function findSpawn(names)
    local world=workspace:FindFirstChild('_WorldOrigin')
    local spawns=world and world:FindFirstChild('EnemySpawns')
    if not spawns then return nil end
    local _,_,root=charParts()
    if not root then return nil end
    local best,bestDist
    for _,part in ipairs(spawns:GetChildren()) do
        if part:IsA('BasePart') then
            for _,name in ipairs(names) do
                if nameMatches(part.Name,name) or nameMatches(part:GetAttribute('DisplayName'),name) then
                    local d=(root.Position-part.Position).Magnitude
                    if not bestDist or d<bestDist then best,bestDist=part,d end
                    break
                end
            end
        end
    end
    return best
end
local function equip()
    local ch,h=charParts()
    if not ch then return nil end
    local item=ch:FindFirstChildOfClass('Tool')
    if item and item.ToolTip==WEAPONS[S.weapon] then return item end
    local backpack=player:FindFirstChild('Backpack')
    for _,container in ipairs({backpack,ch}) do
        if container then
            for _,tool in ipairs(container:GetChildren()) do
                if tool:IsA('Tool') and tool.ToolTip==WEAPONS[S.weapon] then
                    if tool.Parent~=ch then h:EquipTool(tool) end
                    return tool
                end
            end
        end
    end
    -- Se o jogador nao tiver nada equipado, escolhe uma Tool do inventario.
    -- Sem isso o Auto Evento ficava exibindo 'ATACANDO' mas nao atacava.
    if item then return item end
    if backpack then
        for _,candidate in ipairs(backpack:GetChildren()) do
            if candidate:IsA('Tool') and candidate.Enabled then
                h:EquipTool(candidate)
                return candidate
            end
        end
    end
    return nil
end

-- ===== EVENTO: EQUIPAR MELEE DE VERDADE =====
-- Prioriza a categoria ToolTip='Melee'. Se nao estiver definida, reconhece
-- os estilos de luta pelo nome. Nunca troca para uma Sword ou Fruit como fallback.
local MELEE_STYLES = {
    ['combat']=true, ['dark step']=true, ['black leg']=true,
    ['electro']=true, ['electric']=true, ['water kung fu']=true,
    ['dragon breath']=true, ['dragon claw']=true,
    ['superhuman']=true, ['super human']=true, ['death step']=true,
    ['sharkman karate']=true, ['electric claw']=true,
    ['dragon talon']=true, ['godhuman']=true, ['god human']=true,
    ['sanguine art']=true, ['divine art']=true,
    ['fishman karate']=true,
}
local function meleeScore(tool)
    if not tool or not tool:IsA('Tool') then return 0 end
    local tip=tostring(tool.ToolTip or ''):lower()
    local category=tostring(tool:GetAttribute('WeaponType')
        or tool:GetAttribute('Category') or ''):lower()
    if tip=='melee' or category=='melee' then return 100 end
    if tip:find('melee',1,true) then return 95 end
    local name=tool.Name:lower():gsub('%s*%[lv%.?[^%]]*%]','')
    if MELEE_STYLES[name] then return 80 end
    return 0
end
local lastMeleeScan=0
local cachedMelee=nil
local function equipMelee()
    local character,humanoid=charParts()
    if not character or not humanoid or humanoid.Health<=0 then
        return nil
    end
    if cachedMelee and cachedMelee.Parent==character
        and meleeScore(cachedMelee)>0 then
        return cachedMelee
    end
    -- Evita procurar e trocar de Tool em todos os cliques.
    if os.clock()-lastMeleeScan<0.55 then return nil end
    lastMeleeScan=os.clock()
    local backpack=player:FindFirstChildOfClass('Backpack')
        or player:FindFirstChild('Backpack')
    local best,score=nil,0
    for _,container in ipairs({character,backpack or character}) do
        for _,item in ipairs(container:GetChildren()) do
            local candidateScore=meleeScore(item)
            if candidateScore>score then
                best,score=item,candidateScore
            end
        end
    end
    cachedMelee=best
    if best and best.Parent~=character then
        pcall(function() humanoid:EquipTool(best) end)
    end
    if best and best.Parent==character then return best end
    return nil
end

-- Ataque de ferramenta e tentativa de integrar o combate original de Blox Fruits.
-- O servidor do jogo continua validando todos os ataques.
local attackController
local attackControllerChecked=false
local combatModule,combatNet,registerAttack,registerHit
local comboIndex=0
local lastCombatTick=0
local combatSetupDone=false
local function setupCombat()
    if combatSetupDone then return end
    combatSetupDone=true
    pcall(function()
        local modules=RS:FindFirstChild('Modules')
        local combat=modules and modules:FindFirstChild('CombatUtil')
        local netModule=modules and modules:FindFirstChild('Net')
        if combat and netModule then
            combatModule=require(combat)
            combatNet=require(netModule)
            registerAttack=netModule:FindFirstChild('RE/RegisterAttack')
            if combatNet and type(combatNet.RemoteEvent)=='function' then
                registerHit=combatNet:RemoteEvent('RegisterHit',true)
            end
        end
    end)
end
local function attackLikeSource(mob,tool)
    setupCombat()
    if not (combatModule and registerAttack and registerHit) then return false end
    local char,hum,myRoot=charParts()
    local targetRoot=mob and mob:FindFirstChild('HumanoidRootPart')
    if not char or not targetRoot or not tool then return false end
    if (targetRoot.Position-myRoot.Position).Magnitude>60 then return false end
    if os.clock()-lastCombatTick<math.max(0.16,clickDelay(false)) then return false end
    local ok,res=pcall(function()
        if not combatModule:CanAttack(char,combatModule:GetWeaponData(
            combatModule:GetWeaponName(tool)).WeaponType) then return false end
        local name=combatModule:GetWeaponName(tool)
        local data=combatModule:GetWeaponData(name)
        local tracks=combatModule:GetMovesetAnimCache(hum)
        local basics=data and data.Moveset and data.Moveset.Basic
        if not tracks or not basics or #basics==0 then return false end
        comboIndex=comboIndex%#basics+1
        local animName=combatModule:GetPureWeaponName(name)..'-basic'..comboIndex
        local track=tracks[animName]
        if not track then return false end
        local hit=mob:FindFirstChild('Head') or mob:FindFirstChild('UpperTorso')
            or mob:FindFirstChild('Torso') or targetRoot
        local mult=track:GetAttribute('SpeedMult') or 1
        local speed=math.max(0.1,tonumber(mult) or 1)
        registerAttack:FireServer(track.Length/speed)
        registerHit:FireServer(hit,{})
        track:Play(0.1,1,speed)
        lastCombatTick=os.clock()
        return true
    end)
    return ok and res==true
end
-- Referencia ao Auto Click original: ataque com Tool, TAP de frutas e combo.
-- Os metodos continuam sujeitos ao alcance e as validacoes do servidor.
local fruitCombo=0
local fruitTapPending=false
local lastFruitTap=0
local function fruitClick(tool, target)
    if WEAPONS[S.weapon]~='Blox Fruit' then return false end
    if not tool or not target then return false end
    local _,_,myRoot=charParts()
    if not myRoot then return false end
    local part=target:IsA('BasePart') and target
        or (target:IsA('Model') and (target:FindFirstChild('HumanoidRootPart')
            or target.PrimaryPart or target:FindFirstChildWhichIsA('BasePart',true)))
    if not part then return false end
    local difference=part.Position-myRoot.Position
    if difference.Magnitude<0.1 or difference.Magnitude>75 then return false end
    local leftClick=tool:FindFirstChild('LeftClickRemote')
    if leftClick and leftClick:IsA('RemoteEvent') then
        fruitCombo=fruitCombo%5+1
        local ok=pcall(function() leftClick:FireServer(difference.Unit, fruitCombo) end)
        if ok then return true end
    end
    local tap=tool:FindFirstChild('RemoteFunction')
    if tap and tap:IsA('RemoteFunction') then
        if fruitTapPending or os.clock()-lastFruitTap<0.25 then return false end
        fruitTapPending=true
        lastFruitTap=os.clock()
        task.spawn(function()
            pcall(function() tap:InvokeServer('TAP') end)
            fruitTapPending=false
        end)
        return true
    end
    return false
end

local lastToolClick=0
local virtualUser
pcall(function() virtualUser=game:GetService('VirtualUser') end)
local virtualInput
pcall(function() virtualInput=game:GetService('VirtualInputManager') end)
local lastMousePress=0
-- Para jogos que usam entrada de mouse no controlador em vez de Tool.Activated.
-- Algumas experiencias bloqueiam entrada sintetica, entao a chamada e opcional.
local function tryMeleeInput()
    local now=os.clock()
    -- So um clique sintetico a cada 0.38s; Tool:Activate faz os demais.
    -- Evita duplicar eventos e travar a animacao da arma.
    if now-lastMousePress<math.max(0.38,clickDelay(true)) then return false end
    lastMousePress=now
    local camera=workspace.CurrentCamera
    if not camera then return false end
    -- Evita a faixa central onde o menu aparece.
    local middle=Vector2.new(math.max(20,camera.ViewportSize.X-40),camera.ViewportSize.Y*0.6)
    if virtualInput then
        local ok=pcall(function()
            virtualInput:SendMouseButtonEvent(middle.X,middle.Y,0,true,game,0)
            virtualInput:SendMouseButtonEvent(middle.X,middle.Y,0,false,game,0)
        end)
        if ok then return true end
    end
    if virtualUser then
        local ok=pcall(function()
            virtualUser:Button1Down(middle,camera.CFrame)
            virtualUser:Button1Up(middle,camera.CFrame)
        end)
        return ok
    end
    return false
end
local function attack(mob, aimPart, forceMelee)
    local tool=forceMelee and equipMelee() or equip()
    if not tool then
        showMessage(forceMelee and 'SEM MELEE' or 'SEM FERRAMENTA',forceMelee and 'Coloque um estilo de luta Melee no inventario.' or 'Equipe uma Tool no inventario.',false)
        return false
    end
    if not tool.Parent or tool.Parent~=player.Character then
        return false -- aguarda o Melee equipar antes de clicar
    end
    if not tool.Enabled then return false end
    local now=os.clock()
    if now-lastToolClick<clickDelay(forceMelee==true) then
        return false
    end
    lastToolClick=now
    -- NPC com Humanoid: tenta o protocolo de golpe como no Farm original.
    local fired=false
    if mob and mob:IsA('Model') and mob:FindFirstChildOfClass('Humanoid') then
        fired=attackLikeSource(mob,tool) or false
    end
    -- Pumpkin sem Humanoid: nao e um NPC normal; acionamos a Tool equipada
    -- e tentamos um clique do mouse. Nao ha garantia de dano no servidor.
    if not fired then
        local okActivate=pcall(function() tool:Activate() end)
        fired=fired or okActivate
        if forceMelee then
            fired=tryMeleeInput() or fired
        end
    end
    if not forceMelee and mob and fruitClick(tool,aimPart or mob) then fired=true end
    if not forceMelee and not attackControllerChecked then
        attackControllerChecked=true
        pcall(function()
            local controllers=RS:FindFirstChild('Controllers')
            local module=controllers and controllers:FindFirstChild('CombatController')
            if module then attackController=require(module) end
        end)
    end
    if not forceMelee and attackController and type(attackController.Attack)=='function' then
        local ok=pcall(function() attackController.Attack() end)
        if not ok then ok=pcall(function() attackController:Attack() end) end
        fired=fired or ok
    end
    if fired then S.attackAttempts=S.attackAttempts+1 end
    return fired
end

local lastQuestTry=0
local lastQuestKey=''
local function matchQuest(current,wanted)
    return current and wanted and nameMatches(current,wanted)
end

local function verifiedQuest(info)
    if not info then return false,nil end
    local mob=questTask()
    if mob then return matchQuest(mob,info.mob),mob end
    local shown,txt=questUIState()
    if shown and txt:lower():find(tostring(info.mob):lower(),1,true) then
        return true, info.mob
    end
    return false,nil
end

local function acceptQuest(info)
    if not info then
        showMessage('SEM QUEST','Nao existe quest cadastrada para este modo e nivel.',false)
        return false
    end
    local accepted,existing=verifiedQuest(info)
    if accepted then return true end
    if existing then
        showMessage('OUTRA QUEST ATIVA', 'Missao atual: '..existing, false)
        return false
    end
    if not S.autoQuest then
        showMessage('AUTO QUEST OFF','Ative AUTO QUEST para receber a missao.',false)
        return false
    end
    if not comm then
        showMessage('SEM REMOTE','Nao encontrei Remotes.CommF_ no jogo.',false)
        return false
    end

    local pos=coord(info.pos)
    if not pos then
        showMessage('SEM NPC QUEST','O NPC da quest nao tem posicao reconhecida.',false)
        return false
    end

    local key=tostring(info.name)..'/'..tostring(info.id)
    showMessage('INDO PEGAR QUEST',info.mob..' | nivel '..tostring(info.level),true)
    -- O servidor normalmente exige distancia <= 8 studs do quest giver.
    -- Aproximar ate 2 studs do ponto (4 studs acima e 2 a frente) evita
    -- tentar StartQuest de longe, que era um problema da versao anterior.
    local point=pos+Vector3.new(0,4,2)
    if not flyTo(function() return point end, 2) then return false end
    local _,_,root=charParts()
    if not root or (root.Position-pos).Magnitude>7.8 then
        showMessage('QUEST DISTANTE','Nao cheguei perto o suficiente do NPC.',false)
        return false
    end

    if os.clock()-lastQuestTry<2.5 and key==lastQuestKey then
        showMessage('AGUARDANDO QUEST','Esperando resposta da ultima tentativa...',true)
        task.wait(0.5)
        return verifiedQuest(info)
    end
    lastQuestTry=os.clock()
    lastQuestKey=key

    -- Aguardar sincronizacao da posicao com o servidor.
    task.wait(1.5)
    if not S.running then return false end
    local _,_,checkRoot=charParts()
    if not checkRoot or (checkRoot.Position-pos).Magnitude>7.8 then
        showMessage('LONGE DA QUEST','Servidor nao confirmou proximidade; vou me aproximar novamente.',false)
        return false
    end

    showMessage('ACEITANDO QUEST','Enviando '..info.name..' / '..tostring(info.id),true)
    local ok, result=pcall(function()
        return comm:InvokeServer('StartQuest',tostring(info.name),info.id)
    end)
    if not ok then
        showMessage('QUEST RECUSADA',tostring(result):sub(1,95),false)
        task.wait(1)
        return false
    end
    -- Retorno remoto isolado nao comprova sucesso. Conferir dados e a UI.
    for _=1,10 do
        if not S.running then return false end
        local verified=verifiedQuest(info)
        if verified then
            showMessage('QUEST ACEITA',info.mob..' | '..tostring(info.required)..' alvos',true)
            return true
        end
        task.wait(0.2)
    end
    showMessage('QUEST NAO CONFIRMADA',
        'Nao apareceu no rastreador. Tentarei de novo quando o tempo permitir.',false)
    return false
end

local function currentEnemies()
    local active=questTask()
    local mode=MODES[S.mode]
    if mode=='Aura Farm' then
        local enemies=workspace:FindFirstChild('Enemies')
        if not enemies then return nil,'Aguardando inimigos' end
        local closest,closestDist
        local _,_,root=charParts()
        if not root then return nil,'Personagem indisponivel' end
        for _,m in ipairs(enemies:GetChildren()) do
            local h=m:FindFirstChildOfClass('Humanoid')
            local r=m:FindFirstChild('HumanoidRootPart')
            if h and r and h.Health>0 and (r.Position-root.Position).Magnitude<300 then
                local d=(r.Position-root.Position).Magnitude
                if not closestDist or d<closestDist then closest,closestDist=m.Name,d end
            end
        end
        return closest and {closest} or nil, closest or 'Aura Farm'
    end

    -- Se ja ha uma quest, atacar SOMENTE o alvo indicado por ela.
    if active then return {active}, active end

    local info
    if mode=='Level Farm' then
        info=bestLevelQuest()
    else
        info=bestLevelQuest(MODE_QUEST[mode])
    end
    if not info then return nil,'Nenhuma quest compativel com seu nivel' end

    -- Nao iniciar ataques sem confirmar a missao no jogo.
    if not S.autoQuest then
        return nil,'Ative AUTO QUEST para pegar a missao'
    end
    if not acceptQuest(info) then return nil,'Aguardando aceitar '..info.name end
    local mob=questTask() or info.mob
    return {mob}, mob
end

local stopEvent
local farmToken=0
local function stopFarm(message)
    S.running=false
    sense.farmTarget='--'
    sense.damageState='Farm desativado'
    farmToken=farmToken+1
    clearHover()
    theme.startBtn.Text='INICIAR AUTO FARM'
    theme.startBtn.BackgroundColor3=red
    local grad=theme.startBtn:FindFirstChildOfClass('UIGradient')
    if grad then grad.Enabled=true end
    theme.farmInfo.Text='FARM DESLIGADO | Voo 250'
    showMessage('DESLIGADO',message or 'Auto Farm parado.',false)
end
local function startFarm()
    if S.eventRunning and stopEvent then stopEvent('Farm iniciado.') end
    if S.running then stopFarm('Desativado pelo menu.');return end
    if not setupGame() then
        showMessage('API NAO ENCONTRADA', 'Este farm requer GuideModule, Quests e CommF_ do jogo.',false)
        return
    end
    S.running=true
    farmToken=farmToken+1
    local token=farmToken
    theme.startBtn.Text='PARAR AUTO FARM'
    theme.startBtn.BackgroundColor3=Color3.fromRGB(44,135,75)
    local grad=theme.startBtn:FindFirstChildOfClass('UIGradient')
    if grad then grad.Enabled=false end
    theme.farmInfo.Text='FARM ON | Novas quests automaticamente | Voo 250'
    showMessage('INICIANDO','Modo continuo ativo. Procurando a missao e os NPCs...',true)
    sense.damageState='Procurando a missao correta'
    if sense.autoEquip then pcall(function() if S.weapon==1 then equipMelee() else equip() end end) end
    task.spawn(function()
        local questWasSeen=false
        local questMissingAt=nil
        local noTargetSince=0
        while S.running and token==farmToken and gui.Parent do
            local ok,err=pcall(function()
                if S.eventRunning then
                    task.wait(0.45)
                    return
                end
                local _,h,root=charParts()
                if not root then
                    showMessage('AGUARDANDO','Aguardando seu personagem reaparecer.',true)
                    task.wait(1)
                    return
                end
                local active=questTask()
                local uiVisible=questUIState()
                if active or uiVisible then
                    questWasSeen=true
                    questMissingAt=nil
                elseif questWasSeen then
                    questMissingAt=questMissingAt or os.clock()
                end
                -- Atraso para nao confundir a animacao da interface com fim da quest.
                -- A UI da quest pode desaparecer por streaming/animacao.
                -- Em modo continuo (padrao), NUNCA desligue o farm por isso.
                -- Mesmo quando o usuario habilita parada, exige 12s sem dados.
                if S.stopQuest and questWasSeen and questMissingAt
                    and os.clock()-questMissingAt>12 then
                    stopFarm('Missao ausente por 12s (parada opcional ativada).')
                    return
                end
                local names,description=currentEnemies()
                if sense.farmSmart then sense.damageState=description or 'Lendo quest ativa' end
                -- A quest pode ter sido aceita durante currentEnemies().
                local confirmedNow=questTask()
                local visibleNow=questUIState()
                if confirmedNow or visibleNow then
                    questWasSeen=true
                    questMissingAt=nil
                end
                if not names or #names==0 then
                    if not status.Text:find('QUEST NAO CONFIRMADA',1,true)
                        and not status.Text:find('QUEST RECUSADA',1,true) then
                        showMessage('VERIFICANDO QUEST',description or 'Aguardando confirmacao da missao.',true)
                    end
                    task.wait(1)
                    return
                end
                local target=getNearest(names)
                if target then
                    noTargetSince=0
                    sense.farmTarget=target.Name
                    sense.damageState='Aguardando dano'
                    local humanoid=target:FindFirstChildOfClass('Humanoid')
                    local enemyRoot=target:FindFirstChild('HumanoidRootPart')
                    if not humanoid or not enemyRoot then return end
                    local lastEnemyHealth=humanoid.Health
                    local lastProgressAt=os.clock()
                    local lastQuestCheckAt=0
                    showMessage('AUTO FARM ON',target.Name..' | Vida '..math.floor(humanoid.Health),true)
                    while S.running and not S.eventRunning and token==farmToken
                        and target.Parent and humanoid.Health>0 do
                        local _,_,myRoot=charParts()
                        if not myRoot or not enemyRoot.Parent then break end
                        local attackSpot=enemyRoot.Position+Vector3.new(0,S.attackHeight,0)
                        local d=(attackSpot-myRoot.Position).Magnitude
                        if d>2.6 then
                            local arrived=flyTo(function()
                                if not enemyRoot.Parent then return nil end
                                return enemyRoot.Position+Vector3.new(0,S.attackHeight,0)
                            end,2.5)
                            if not arrived then break end
                        end
                        holdNear(enemyRoot.Position)
                        if sense.autoEquip then equip() end
                        attack(target)
                        -- Se o NPC nao perde vida, troca de alvo sem desligar o farm.
                        local healthNow=humanoid.Health
                        if healthNow<lastEnemyHealth-0.01 then
                            lastProgressAt=os.clock()
                            sense.damageState='Dano confirmado: -'..math.floor(lastEnemyHealth-healthNow)
                        elseif sense.watchDamage and os.clock()-lastProgressAt>=3 then
                            sense.damageState='SEM DANO HA '..math.floor(os.clock()-lastProgressAt)..'s'
                        end
                        lastEnemyHealth=healthNow
                        if sense.skipStuck and os.clock()-lastProgressAt>=11 then
                            ignoredFarmTargets[target]=os.clock()+9
                            S.farmTargetsSkipped=S.farmTargetsSkipped+1
                            showMessage('TROCANDO NPC',
                                'Alvo sem perder vida por 11s; buscando outro.',true)
                            break
                        end
                        -- Ler quest em frequencia baixa, nao a cada clique.
                        if os.clock()-lastQuestCheckAt>=0.8 then
                            lastQuestCheckAt=os.clock()
                            local tracking=questTask()
                            local uiTracking=questUIState()
                            if tracking or uiTracking then
                                questWasSeen=true
                                questMissingAt=nil
                            elseif questWasSeen and S.stopQuest then
                                questMissingAt=questMissingAt or os.clock()
                                if os.clock()-questMissingAt>12 then
                                    stopFarm('Missao ausente por 12s (parada opcional ativada).')
                                    break
                                end
                            end
                        end
                        task.wait(clickDelay(false))
                    end
                    clearHover()
                else
                    sense.farmTarget='Aguardando NPC'
                    if noTargetSince==0 then noTargetSince=os.clock() end
                    local spawn=findSpawn(names)
                    if spawn then
                        showMessage('PROCURANDO NPC',description or table.concat(names,', '),true)
                        flyTo(function()
                            if not spawn.Parent then return nil end
                            return spawn.Position+Vector3.new(0,35,0)
                        end,7)
                        pcall(function() player:RequestStreamAroundAsync(spawn.Position,2) end)
                    elseif os.clock()-noTargetSince>4 then
                        showMessage('NPC NAO ENCONTRADO', 'Aguardando o inimigo aparecer no mapa.',true)
                    end
                    task.wait(0.40)
                end
            end)
            if not ok then
                showMessage('ERRO',tostring(err):sub(1,75),false)
                task.wait(1)
            end
            task.wait(0.045)
        end
        clearHover()
    end)
end

