local watchedEventFolders=setmetatable({},{__mode='k'})
local eventFolderNames={Enemies=true,Events=true,Event=true,NPCs=true,
    Halloween=true,Pumpkins=true,EventObjects=true,Map=true}
local function watchEventFolder(folder)
