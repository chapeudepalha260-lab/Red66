local function menuToggle(where,text,key)
    extraStates[key]=false
    local b
    b=menuAction(where,text..': OFF',function()
        extraStates[key]=not extraStates[key]
        b.Text=text..': '..(extraStates[key] and 'ON' or 'OFF')
        b.BackgroundColor3=extraStates[key] and Color3.fromRGB(125,35,51) or Color3.fromRGB(35,35,40)
        showMessage('CONFIGURACAO',text..': '..(extraStates[key] and 'ON' or 'OFF'),extraStates[key])
    end)
    return b
end
local function invokeCommand(...)
    local remote=commRemote()
    if not remote or not remote:IsA('RemoteFunction') then
        showMessage('SEM INTEGRACAO','CommF_ nao disponivel neste jogo.',false)
        return false
    end
    local args={...}
    local ok,result=pcall(function() return remote:InvokeServer(table.unpack(args)) end)
    if not ok then
        showMessage('SERVIDOR RECUSOU',tostring(result):sub(1,110),false)
        return false
    end
    showMessage('COMANDO ENVIADO',tostring(args[1]),true)
    return true,result
end
local lastExtraCall=0
local function waitForSingleCall()
    -- Evita centenas de remotes em sequencia depois de cliques repetidos.
    if os.clock()-lastExtraCall<0.7 then return false end
    lastExtraCall=os.clock()
    return true
end
local function tryOnce(...)
    if waitForSingleCall() then return invokeCommand(...) end
    showMessage('CALMA','Aguarde 0.7s entre comandos.',false)
end
local function runManualJourney(pos)
    local destination=coord(pos)
    if not destination then return end
    if S.running or S.eventRunning then
        showMessage('VOO OCUPADO','Desative Farm/Evento para usar o TP manual.',false)
        return
    end
    S.manualTravel=false
    cancelFlight()
    task.wait(0.05)
    S.manualTravel=true
    task.spawn(function()
        showMessage('VOANDO 250','Deslocamento manual em andamento.',true)
        flyTo(function() return destination end,5,'manual')
        S.manualTravel=false
        showMessage('TP FINALIZADO','Voce chegou ou interrompeu o deslocamento.',false)
    end)
end

