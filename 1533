-- RADAR INTELIGENTE: radar, contador, diagnostico e destaque VIP leve (max. 1 Highlight).
do
    local vipTarget=nil
    local vipHighlight=nil
    local function setVip(model)
        if vipTarget==model and vipHighlight and vipHighlight.Parent then return end
        if vipHighlight then vipHighlight:Destroy(); vipHighlight=nil end
        vipTarget=model
        if not model or not model:IsA('Model') then return end
        vipHighlight=Instance.new('Highlight')
        vipHighlight.Name='BLACK_CYBER_DRAGON_VIP'
        vipHighlight.FillColor=Color3.fromRGB(255,80,85)
        vipHighlight.OutlineColor=Color3.fromRGB(255,224,103)
        vipHighlight.FillTransparency=0.82
        vipHighlight.OutlineTransparency=0.1
        vipHighlight.DepthMode=Enum.HighlightDepthMode.Occluded
        vipHighlight.Adornee=model
        vipHighlight.Parent=model
    end
    gui.Destroying:Connect(function()
        if vipHighlight then vipHighlight:Destroy() end
    end)
    local function readMastery()
        if not sense.watchMastery then return 'Desligado' end
        local ch=player.Character
        local tool=ch and ch:FindFirstChildOfClass('Tool')
        if not tool then return 'Equipe Melee, Sword ou Fruit' end
        local mastery=tool:GetAttribute('Mastery') or tool:GetAttribute('Level')
        if type(mastery)~='number' then
            local level=tool:FindFirstChild('Level') or tool:FindFirstChild('Mastery')
            if level and (level:IsA('NumberValue') or level:IsA('IntValue')) then
                mastery=level.Value
            end
        end
        -- Muitas ferramentas de Blox Fruits nao expõem a Mastery no Tool ao cliente.
        if type(mastery)=='number' then
            return tool.Name..' • Lv '..math.floor(mastery)
        end
        return tool.Name..' • nivel nao exposto'
    end
    task.spawn(function()
        while gui.Parent do
            local waitFor=2.0
            if S.eventRunning then
                local fps=currentFPS()
                waitFor=fps<24 and 3.5 or 2.0
                -- Radar suspende suas leituras extras sob FPS critico.
                if fps<13 then
                    sense.radarSnow=false
                    sense.radarJack=false
                    sense.radarPumpkin=false
                    if theme.pages.EVENTO.Visible then sense.radarInfo.Text='RADAR PAUSADO: FPS baixo' end
                    if sense.updatePanel and panel.Visible then sense.updatePanel() end
                    task.wait(4)
                    continue
                end
                local snow,snowRoot=snowman.find()
                local jack,jackRoot=findJackNpc(nil,450)
                local pumpkin,pumpkinRoot=findEventTarget()
                sense.radarSnow=(snow~=nil and snowRoot~=nil)
                sense.radarJack=(jack~=nil and jackRoot~=nil)
                sense.radarPumpkin=(pumpkin~=nil and pumpkinRoot~=nil)
                setVip(snow)
                if theme.pages.EVENTO.Visible then
                    sense.radarInfo.Text='RADAR: S '..(sense.radarSnow and '●' or '-')
                        ..' | J '..(sense.radarJack and '●' or '-')
                        ..' | P '..(sense.radarPumpkin and '●' or '-')
                        ..' | Tempo '..math.floor(os.clock()-sense.focusSince)..'s'
                end
            else
                sense.radarSnow=false
                sense.radarJack=false
                sense.radarPumpkin=false
                setVip(nil)
                if theme.pages.EVENTO.Visible then
                    sense.radarInfo.Text='RADAR: ative AUTO EVENTO para detectar alvos.'
                end
            end
            if S.running and sense.watchMastery then
                sense.masteryState=readMastery()
            elseif not S.running then
                sense.masteryState='Ligue o Farm para acompanhar'
            end
            if sense.updatePanel and panel.Visible then sense.updatePanel() end
            task.wait(waitFor)
        end
    end)
end

