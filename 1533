end

-- Mesmo ataque da aba FARM, mas com repeticao mais curta.
-- Nao causa dano ficticio: o servidor deve aceitar o ataque da Tool.
local function fightJack(npc,root,anchor,token)
    if not npc or not root then return false end
    local humanoid=npc:FindFirstChildOfClass('Humanoid')
    if not humanoid then return false end
    sense.focus('JACK',npc.Name)
    equipMelee() -- se surgir Jack, permanece no Melee
    local lastHealth=humanoid.Health
    local idleSince=nil
    while eventActive(token) and not eventTargetGone(npc,root) do
        -- Quando Snowman aparece, interrompe Jack imediatamente.
        local priorityNpc=snowman.find()
        if sense.higher('SNOWMAN','JACK') and priorityNpc and priorityNpc~=npc then
            clearHover()
            return false
        end
        local _,_,myRoot=charParts()
        if not myRoot then break end
        local dist=(myRoot.Position-(root.Position+Vector3.new(0,S.attackHeight,0))).Magnitude
        if dist>2.6 then
            showMessage('INDO AO JACK','Jack o Lantern apareceu! Voo 250 studs/s.',true)
            local arrived=flyTo(function()
                if eventActive(token) and not eventTargetGone(npc,root)
                    and (not sense.higher('SNOWMAN','JACK') or not snowman.find()) then
                    return root.Position+Vector3.new(0,S.attackHeight,0)
                end
                return nil
            end,2.5,'event',function()
                setBlocked(anchor or root.Position,'Sem movimento durante voo ao Jack',npc)
            end)
            if not arrived then break end
            idleSince=nil -- tempo parado so conta durante ataque
        else
            holdNear(root.Position)
            showMessage('ATACANDO JACK',npc.Name..' | Vida: '..math.floor(humanoid.Health),true)
            if theme.eventInfo.Text~='Melee tentando golpes no Jack. Dano depende do jogo.' then
                theme.eventInfo.Text='Melee tentando golpes no Jack. Dano depende do jogo.'
            end
            if S.autoAttack then attack(npc,nil,true) end -- Melee equipado automaticamente
            local health=humanoid.Health
            if health < lastHealth-0.01 then
                idleSince=os.clock() -- houve progresso: reinicia o limite
            elseif not idleSince then
                idleSince=os.clock()
            end
            lastHealth=health
            if S.autoAttack and idleSince and os.clock()-idleSince>=10 then
                setBlocked(anchor or root.Position,'Jack sem perder vida por 10s',npc)
                showMessage('JACK SEM PROGRESSO','Ignorando este local e procurando outro Pumpkin.',true)
                return false
            end
            task.wait(eventClickDelay())
        end
    end
    clearHover()
    if eventActive(token) and eventTargetGone(npc,root) then
        S.jacksDefeated=S.jacksDefeated+1
        showMessage('JACK DERROTADO','Agora vou procurar outro Pumpkin.',true)
        theme.eventInfo.Text='Jack derrotado/desapareceu. Indo ao proximo Pumpkin.'
        return true
    end
    return false
end

snowman.fight=function(npc,root,token)
    if not npc or not root then return false end
    local humanoid=npc:IsA('Model') and npc:FindFirstChildOfClass('Humanoid')
    if humanoid and humanoid.Health<=0 then return false end
    sense.focus('SNOWMAN',npc.Name)
    equipMelee()
    showMessage('SNOWMAN PRIORIDADE 1',npc.Name..' | MELEE AUTOMATICO',true)
    theme.eventInfo.Text='SNOWMAN DETECTADO | Prioridade maxima | Voo 250'
    local lastHealth=humanoid and humanoid.Health or nil
    local progressAt=os.clock()
    while eventActive(token) and not eventTargetGone(npc,root)
        and not blockedTargets[npc] do
        local _,_,myRoot=charParts()
        if not myRoot then break end
        if (myRoot.Position-(root.Position+Vector3.new(0,S.attackHeight,0))).Magnitude>2.6 then
            local arrived=flyTo(function()
                if eventActive(token) and not eventTargetGone(npc,root) then
                    return root.Position+Vector3.new(0,S.attackHeight,0)
                end
                return nil
            end,2.5,'event',function()
                blockedTargets[npc]=true
                theme.eventInfo.Text='SNOWMAN: sem movimento; procurando outro'
            end)
            if not arrived then break end
            progressAt=os.clock()
        else
            holdNear(root.Position)
            if S.autoAttack then attack(npc,nil,true) end
            local health=humanoid and humanoid.Health or nil
            if lastHealth and health and health<lastHealth-0.01 then
                progressAt=os.clock()
            end
            lastHealth=health
            if S.autoAttack and os.clock()-progressAt>=10 then
                blockedTargets[npc]=true -- nao bloqueia o lugar: Snowman novo pode nascer la
                theme.eventInfo.Text='Snowman sem perder vida por 10s; trocando de alvo.'
                break
            end
            task.wait(eventClickDelay())
        end
    end
    clearHover()
    if eventActive(token) and eventTargetGone(npc,root) then
        S.snowmenDefeated=S.snowmenDefeated+1
        showMessage('SNOWMAN FINALIZADO','Procurando o proximo evento.',true)
        return true
    end
    return false
end

local function startEvent()
    if S.eventRunning then stopEvent('Desligado pelo menu.'); return end
    -- Evento tem prioridade de movimento, mas nao desliga o Auto Farm.
    -- Quando o Evento for desligado, o Farm continua automaticamente.
    if S.running then
        theme.farmInfo.Text='FARM PAUSADO PELO EVENTO | retornara automaticamente'
        showMessage('FARM EM ESPERA','Evento tem prioridade. Farm continuara ao desligar Evento.',true)
    end
    S.eventRunning=true
    startEventIndex()
    eventToken=eventToken+1
    local token=eventToken
    theme.eventBtn.Text='PARAR AUTO EVENTO'
    theme.eventBtn.BackgroundColor3=green
    local grad=theme.eventBtn:FindFirstChildOfClass('UIGradient')
    if grad then grad.Enabled=false end
    theme.eventInfo.Text=table.concat(sense.orders[sense.eventPriority],' > ')..' | Melee e Auto Attack prontos.'
    task.spawn(function()
        while eventActive(token) do
            local ok,err=pcall(function()
                -- Consulta cacheada dos tres tipos; respeita a ordem escolhida.
                local snow,snowRoot=snowman.find()
                local loneJack,loneRoot=findJackNpc(nil,300)
                local target,root=findEventTarget()
                local available={
                    SNOWMAN=snow and snowRoot and {snow,snowRoot} or nil,
                    JACK=loneJack and loneRoot and {loneJack,loneRoot} or nil,
                    PUMPKIN=target and root and {target,root} or nil,
                }
                local first=nil
                for _,kind in ipairs(sense.orders[sense.eventPriority]) do
                    if available[kind] then first=kind; break end
                end
                if first=='SNOWMAN' then
                    snowman.fight(snow,snowRoot,token)
                    return
                elseif first=='JACK' then
                    fightJack(loneJack,loneRoot,loneRoot.Position,token)
                    return
                elseif first~='PUMPKIN' then
                    sense.focus('BUSCANDO','--')
                    showMessage('BUSCANDO EVENTO','Procurando Snowman, Jack e Pumpkin.',true)
                    task.wait(0.85)
                    return
                end
                local pumpkinPosition=root.Position
                sense.focus('PUMPKIN',target.Name)
                equipMelee() -- ja equipa o estilo de luta durante a ida ao Pumpkin
                showMessage('VOANDO 250','MELEE preparado | Pumpkin: '..target.Name,true)
                theme.eventInfo.Text='Voando ate '..target.Name..' (250 studs/s)'
                local arrived=flyTo(function()
                    if not eventTargetGone(target,root) and not blockedTargets[target]
                        and not isBlocked(pumpkinPosition)
                        and (not sense.higher('SNOWMAN','PUMPKIN') or not snowman.find()) then
                        return root.Position+Vector3.new(0,S.attackHeight,0)
                    end
                    return nil
                end,2.5,'event',function()
                    setBlocked(pumpkinPosition,'Preso por 10s durante voo',target)
                end)
                if not eventActive(token) then return end
                if sense.higher('SNOWMAN','PUMPKIN') and snowman.find() then return end -- prioridade personalizada
                -- Pumpkin pode sumir ao chegar e gerar Jack no lugar.
                local jack,jackRoot=findJackNpc(pumpkinPosition,200)
                if jack and sense.higher('JACK','PUMPKIN') then
                    fightJack(jack,jackRoot,pumpkinPosition,token)
                    if sense.higher('SNOWMAN','PUMPKIN') and snowman.find() then return end
                    S.pumpkinsProcessed=S.pumpkinsProcessed+1
                    setBlocked(pumpkinPosition,'Pumpkin visitado e Jack processado',target)
                    return
                end
                if not arrived or isBlocked(pumpkinPosition) then return end

                local attackStarted=os.clock()
                while eventActive(token) and not blockedTargets[target]
                    and not isBlocked(pumpkinPosition) do
                    -- Snowman tem prioridade inclusive sobre Jack e Pumpkin.
                    if sense.higher('SNOWMAN','PUMPKIN') and snowman.find() then
                        theme.eventInfo.Text='Snowman surgiu: trocando de alvo prioritario.'
                        break
                    end
                    jack,jackRoot=findJackNpc(pumpkinPosition,200)
                    if jack and sense.higher('JACK','PUMPKIN') then
                        showMessage('JACK APARECEU','Mudando do Pumpkin para o NPC da imagem.',true)
                        fightJack(jack,jackRoot,pumpkinPosition,token)
                        if sense.higher('SNOWMAN','PUMPKIN') and snowman.find() then break end
                        S.pumpkinsProcessed=S.pumpkinsProcessed+1
                        setBlocked(pumpkinPosition,'Proximo Pumpkin apos o Jack',target)
                        break
                    end
                    if eventTargetGone(target,root) then
                        -- Uma pequena janela para o jogo criar o Jack apos sumir o Pumpkin.
                        showMessage('PUMPKIN SUMIU','Verificando se Jack o Lantern apareceu...',true)
                        for _=1,15 do
                            if not eventActive(token) then return end
                            task.wait(0.04)
                            if sense.higher('SNOWMAN','PUMPKIN') and snowman.find() then break end
                            jack,jackRoot=findJackNpc(pumpkinPosition,200)
                            if jack then
                                fightJack(jack,jackRoot,pumpkinPosition,token)
                                break
                            end
                        end
                        S.pumpkinsProcessed=S.pumpkinsProcessed+1
                        setBlocked(pumpkinPosition,'Pumpkin terminado',target)
                        break
                    end
                    if S.autoAttack and os.clock()-attackStarted>=10 then
                        setBlocked(pumpkinPosition,'Pumpkin nao sumiu em 10s',target)
                        showMessage('TROCANDO PUMPKIN','Sem progresso em 10s. Procurando outro alvo.',true)
                        break
                    end
                    local _,_,myRoot=charParts()
                    if not myRoot then break end
                    if (myRoot.Position-(root.Position+Vector3.new(0,S.attackHeight,0))).Magnitude>2.6 then
                        local moved=flyTo(function()
                            if not eventTargetGone(target,root) and not blockedTargets[target]
                                and (not sense.higher('SNOWMAN','PUMPKIN') or not snowman.find()) then
                                return root.Position+Vector3.new(0,S.attackHeight,0)
                            end
                            return nil
                        end,2.5,'event',function()
                            setBlocked(pumpkinPosition,'Personagem preso',target)
                        end)
                        if not moved then break end
                    else
                        holdNear(root.Position)
                        showMessage('MELEE: TENTANDO GOLPES',target.Name..' | aguardando Jack ou sumir',true)
                        if theme.eventInfo.Text~='Tentando M1 no Pumpkin. Se nao sofrer dano em 10s, troca.' then
                            theme.eventInfo.Text='Tentando M1 no Pumpkin. Se nao sofrer dano em 10s, troca.'
                        end
                        if S.autoAttack then
                            local fired=attack(target,root,true)
                            if not fired then
                                theme.eventInfo.Text='Melee nao acionado; confira se a ferramenta foi equipada.'
                            end
                        else
                            theme.eventInfo.Text='Auto Attack OFF: voce controla os golpes.'
                        end
                        task.wait(eventClickDelay())
                    end
                end
                clearHover()
                task.wait(0.04)
            end)
            if not ok then
                theme.eventInfo.Text='Erro no evento: '..tostring(err):sub(1,90)
                task.wait(0.3)
            end
            task.wait(math.max(0.24,eventClickDelay()))
        end
        clearHover()
    end)
end
