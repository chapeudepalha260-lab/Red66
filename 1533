local function eventModelAllowed(model,root)
    local compactName=normalize(model.Name):gsub('[^%a%d]','')
    -- Snowman e Jack sao tratados como bosses de evento, nunca como aboboras.
    if compactName:find('jackolantern',1,true)
        or snowman.isName(model.Name) or snowman.labels[model] then return false end
    local kind=theme.eventModes[S.eventMode]
    if kind=='PUMPKIN' then return pumpkinLabels[model] or normalize(model.Name):find('pumpkin',1,true)~=nil end
    if kind=='PIRATE RAID' then
        if (root.Position-raidCenter).Magnitude>1000 then return false end
        return not hasKeyword(model.Name,{'boss','friend','wraith','indra'})
    elseif kind=='BOSS EVENTO' then
        return hasKeyword(model.Name,{'boss','core','tyrant'})
    end
    return displayTextMatches(model,'pumpkin') or hasKeyword(model.Name,eventKeywords)
        or model:GetAttribute('IsEvent')==true
        or model:GetAttribute('EventEnemy')==true
end

-- Detector leve: cacheia as etiquetas de eventos, indexando o mapa aos poucos.
-- A versao antiga usava workspace:GetDescendants() em um loop de 0.035s,
-- que podia bloquear o cliente por tempo indeterminado em mapas grandes.
local eventCandidates=setmetatable({},{__mode='k'})
local indexing=false
local indexingFinished=false
local eventConnections={}

local function candidateOfLabel(label)
    local bill=label:FindFirstAncestorOfClass('BillboardGui')
    local candidate=(bill and bill.Adornee and getOwnerFromAdornee(bill.Adornee))
        or label:FindFirstAncestorOfClass('Model')
    -- Uma etiqueta pode estar num modelo filho; subimos ate o NPC com Humanoid.
    local parent=candidate
    for _=1,4 do
        if not parent or parent==workspace then break end
        if parent:IsA('Model') and parent:FindFirstChildOfClass('Humanoid') then
            return parent
        end
        parent=parent.Parent
    end
    return candidate
end
local function rememberEvent(inst)
    if not inst or not S.eventRunning then return end
    if inst:IsA('TextLabel') then
        if not inst:FindFirstAncestorOfClass('BillboardGui') then return end
        local txt=normalize(inst.Text)
        if not txt:find('pumpkin',1,true) and not txt:find('snowman',1,true) then return end
        local candidate=candidateOfLabel(inst)
        if candidate and candidate~=player.Character then
            eventCandidates[candidate]=true
            if snowman.isName(txt) then
                snowman.labels[candidate]=true
            elseif txt:find('pumpkin',1,true) then
                pumpkinLabels[candidate]=true
            end
        end
    elseif inst:IsA('Model') or inst:IsA('BasePart') then
        -- O hook global recebe muitos objetos; sai cedo para os irrelevantes.
        local nm=inst.Name:lower()
        local byName=nm:find('pumpkin',1,true) or nm:find('snowman',1,true)
            or (S.eventMode~=1 and hasKeyword(nm,eventKeywords))
        if not byName and not inst:IsA('Model') then return end
        if byName or inst:GetAttribute('IsEvent')==true
            or inst:GetAttribute('EventEnemy')==true then
            local candidate=inst
            if inst:IsA('BasePart') and inst.Parent and inst.Parent:IsA('Model') then
                candidate=inst.Parent
            end
            if snowman.isName(nm) then snowman.labels[candidate]=true end
            eventCandidates[candidate]=true
        end
    end
end
local function startEventIndex()
    if indexing or indexingFinished then return end
    indexing=true
    task.spawn(function()
        -- Procura primeiro nos lugares mais provaveis, inclusive os objetos
        -- com label Pumpkin. NUNCA varre todo o Workspace sem limite.
        local queue={}
        local seenRoot={}
        for _,folderName in ipairs({'Enemies','Events','Event','Pumpkins',
            'Halloween','EventObjects','NPCs','Map'}) do
            local obj=workspace:FindFirstChild(folderName)
            if obj and not seenRoot[obj] then
                queue[#queue+1]=obj
                seenRoot[obj]=true
            end
        end
        -- Nao indexar PlayerGui inteiro: sao controles e nao alvos no mapa.
        -- Objetos de evento que aparecem diretamente em Workspace.
        for _,obj in ipairs(workspace:GetChildren()) do
            if not seenRoot[obj] and obj~=workspace.CurrentCamera
                and (normalize(obj.Name):find('pumpkin',1,true)
                    or obj:GetAttribute('IsEvent')==true) then
                queue[#queue+1]=obj
            end
        end
        local head=1
        local visited=0
        -- Limite pequeno e fatias curtas: evita picos de CPU em mapas enormes.
        local limit=1100
        while gui.Parent and S.eventRunning and head<=#queue and visited<limit do
            for _=1,6 do
                if head>#queue or visited>=limit or not S.eventRunning then break end
                local obj=queue[head]
                queue[head]=false
                head=head+1
                visited=visited+1
                if obj.Parent then
                    pcall(rememberEvent,obj)
                    if obj.Name~='Terrain' and obj.Name~='Effects'
                        and obj.Name~='VFX' and obj.Name~='Particles'
                        and obj.Name~='Debris' then
                        local children=obj:GetChildren()
                        if #children<=500 then
                            for _,child in ipairs(children) do
                                if #queue-head < 1300 then queue[#queue+1]=child end
                            end
                        end
                    end
                end
            end
            task.wait(currentFPS()<30 and 0.23 or 0.13)
        end
        indexingFinished=gui.Parent~=nil and S.eventRunning
        indexing=false
        if S.eventRunning and not indexingFinished then
            theme.eventInfo.Text='Busca leve ativa: limite de objetos atingido; novos Pumpkins ainda serao detectados.'
        end
    end)
end

