-- Coleta somente Tools (frutas que podem ir ao inventario).
-- Modelos/estatuas com placa "Fruit1", "Fruit2", etc. nao sao frutas coletaveis.
local function isRealFruitPickup(obj)
    if not obj or not obj:IsA('Tool') then return false end
    local name=obj.Name:lower()
    if not name:find('fruit',1,true) then return false end
    if name:match('^fruit%s*%d+$') then return false end -- ignora Fruit1 da imagem
    if obj:GetAttribute('IsDecoration') or obj:GetAttribute('Decorative') then return false end
    local handle=obj:FindFirstChild('Handle')
    if not handle or not handle:IsA('BasePart') then return false end
    return true,handle
end

local function getFruitTool()
    local _,_,root=charParts()
    if not root then return nil end
    local best,dist=nil,math.huge
    -- Somente objetos soltos: nao procura frutas guardadas em NPCs/estatuas.
    for _,folder in ipairs({workspace,workspace:FindFirstChild('Fruits')}) do
        if folder then
            for _,obj in ipairs(folder:GetChildren()) do
                local valid,handle=isRealFruitPickup(obj)
                if valid and handle then
                    local d=(handle.Position-root.Position).Magnitude
                    if d<dist then best,dist=obj,d end
                end
            end
        end
    end
    return best
end

