        TextColor3=faded,TextSize=12},footer)
    local resize=make('TextButton',{Name='Redimensionar',Text='◢',
        TextColor3=faded,TextSize=15,BackgroundTransparency=1,
        AutoButtonColor=false,Size=UDim2.fromOffset(26,27),
        Position=UDim2.new(1,-26,0,0)},footer)
    local resizing,startPoint,startDimensions=false,nil,nil
    resize.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1
            or input.UserInputType==Enum.UserInputType.Touch then
            resizing=true; startPoint=input.Position;startDimensions=panel.AbsoluteSize
        end
    end)
    local moving=UIS.InputChanged:Connect(function(input)
        if not resizing or not startPoint then return end
        if input.UserInputType~=Enum.UserInputType.MouseMovement
            and input.UserInputType~=Enum.UserInputType.Touch then return end
        local move=input.Position-startPoint
        local max=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280,720)
        local scale=math.max(0.35,uiScale.Scale)
        panel.Size=UDim2.fromOffset(
            math.clamp(startDimensions.X/scale+move.X/scale,600,math.max(600,max.X/scale-24)),
            math.clamp(startDimensions.Y/scale+move.Y/scale,620,math.max(620,max.Y/scale-28)))
    end)
    local ended=UIS.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1
            or input.UserInputType==Enum.UserInputType.Touch then resizing=false end
    end)
    gui.Destroying:Connect(function()
        moving:Disconnect();ended:Disconnect()
    end)
end

