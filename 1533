local chosenBoss=nil
local bossInfo=menuNote('BOSSES','Boss selecionado: mais proximo disponivel')
local function chooseBoss()
    local enemies=workspace:FindFirstChild('Enemies')
    if not enemies then return end
    local seen,names={},{}
    for _,enemy in ipairs(enemies:GetChildren()) do
        if enemy:IsA('Model') and enemy:FindFirstChildOfClass('Humanoid') then
            local n=enemy.Name
            if n:lower():find('boss',1,true) or n:lower():find('rip indra',1,true)
                or n:lower():find('darkbeard',1,true) or n:lower():find('katakuri',1,true)
                or n:lower():find('jack',1,true) then
                if not seen[n] then seen[n]=true; names[#names+1]=n end
            end
        end
    end
    table.sort(names)
    if #names==0 then bossInfo.Text='Nenhum boss carregado no cliente.'; return end
    local idx=1
    for i,n in ipairs(names) do if n==chosenBoss then idx=i%#names+1; break end end
    chosenBoss=names[idx]
    bossInfo.Text='Boss selecionado: '..chosenBoss
end
